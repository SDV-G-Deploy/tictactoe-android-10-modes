<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="background">#F5F7FA</color>
    <color name="cell_bg">#FFFFFF</color>
    <color name="cell_border">#C8D0DB</color>
    <color name="text_primary">#1C2A39</color>
    <color name="text_secondary">#516173</color>
    <string name="app_name">Крестики-нолики</string>
    <string name="draw_text">Ничья</string>
    <string name="new_game">Новая игра</string>
    <string name="turn_text">Ход: %1$s</string>
    <string name="winner_text">Победил: %1$s</string>
    <style name="Theme.TicTacToe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor" ns1:targetApi="l">@color/background</item>
        <item name="android:navigationBarColor" ns1:targetApi="l">@color/background</item>
    </style>
    <style name="TicCellButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/cell_bg</item>
        <item name="strokeColor">@color/cell_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>